# Phase 3 thin slice: /review calls one OpenAI-compatible chat model.
# Copy to .env and fill in real values. Never commit real keys.

# Required. Any OpenAI-compatible provider key (OpenAI, DeepSeek, Moonshot, Qwen, ...).
# EVOREVIEW_LLM_API_KEY=sk-...

# Optional. Switch provider by pointing base_url elsewhere.
# EVOREVIEW_LLM_BASE_URL=https://api.deepseek.com/v1

# Optional. Model name understood by the configured provider.
# EVOREVIEW_LLM_MODEL=deepseek-chat
