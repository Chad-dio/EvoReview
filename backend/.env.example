# Copy values into backend/.local/application-local.yml instead of exporting these
# if you prefer a local YAML file. Do not put real secrets in this example file.

GITHUB_APP_ID=your-github-app-id
GITHUB_APP_CLIENT_ID=your-github-app-client-id
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_APP_PRIVATE_KEY_PATH=.local/github-app.pem
GITHUB_PUBLIC_BASE_URL=https://your-public-host
